# Codacy runs pylint with this file. Line length is deliberately not enforced:
# ruff ignores E501 repo-wide (pyproject.toml [tool.ruff]) and the base tree
# already carries ~1000 lines over 120 chars, so pylint flagging them would only
# produce noise on every diff that touches a long SQL string. Docstring and
# convention rules stay off: the legacy modules predate them and ruff already
# owns style. redefined-outer-name is the standard pytest fixture pattern
# (a test parameter named like the fixture it requests).
[MAIN]
max-line-length = 120

[MESSAGES CONTROL]
disable =
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    duplicate-code,
    fixme,
    broad-exception-caught,
    import-outside-toplevel,
    protected-access,
    too-many-locals,
    global-statement,
    too-many-branches,
    too-many-statements,
    too-many-arguments,
    too-many-positional-arguments,
    unspecified-encoding,
    line-too-long,
    redefined-outer-name

[BASIC]
good-names = i, j, k, x, y, z, db, id, ok, ui, ph, ex, e, n, q, c, w
