<?xml version="1.0" encoding="UTF-8"?>
<!--
  FPDB Dynamic — the reference HUD for context-aware panels.

  How it works: fpdb's dynamic-panel resolver (fpdb_3_legacy/hud_situation.py,
  the shipped rules in hud_situation.d/core.json) decides, from the situation a
  player is in, which blocks a seat should be showing. A block is a panel of a
  stat set, so this profile is ONE stat set whose blocks are the twenty panels
  the resolver can select, and the package then enables the shipped rules for
  THIS PROFILE ONLY:

      <hud_panel_rules enabled="true" source="builtin" fallback="core"
                       profile="nlhe_6max_dynamic"/>

  The `profile` attribute is what keeps the promise the epic makes: importing
  this package does not turn dynamic panels on for the HUD you already use. A
  table running any other profile resolves no rule and keeps its static grid.

  The blocks belong to the profile below and not to profiles of their own: a
  resolver can only select a block that the *active* stat set contains, so a
  panel shipped as a separate stat set would never be shown at all.

  What is live: on a source that publishes action-by-action context the panels
  follow the current decision; elsewhere the resolver gets what the assembled
  hand says, so panels change when the hand is refreshed. The UI says which one
  a source does — this package does not claim more than fpdb can deliver.

  Reading the blocks: every block's label is the panel name the rule library
  uses, because that label is what the resolver matches against. `core` is the
  fallback and the always-visible panel, so it carries no position binding. The
  other eighteen carry the position binding "dynamic" — a seat code no table
  ever has — which is what keeps them hidden until a rule names them:

    preflop_open, preflop_facing_open, preflop_facing_three_bet, preflop_squeeze,
    blinds_defence, blinds_steal, preflop_deep,
    srp_cbet_ip, srp_cbet_oop, srp_face_cbet_ip, srp_face_cbet_oop,
    srp_probe_ip, threebet_pot_ip, threebet_pot_oop, fourbet_pot,
    ssh_stack, overbet_river, minbet_faced.

  How to use it: Preferences > HUD > Import. The package adds a profile-selection
  rule for normal-speed Winamax Hold'em and a profile-scoped dynamic-panel rule;
  fast-fold tables keep their existing profile. The profile can still be chosen
  manually for other sites. With the dynamic rules off it is a plain 2x2 grid.
  Context panels start at five hands so the spot-specific view is useful early;
  each panel still shows the hand sample, and deep-stack waits for 200.

  Known limitations: the sizing and stack panels (overbet_river, minbet_faced,
  ssh_stack) only fire when the hand context carries the sizing or the stack
  bucket, and a source that cannot report them leaves those panels unused
  rather than guessing. The panels are resolved per seat, so a table where the
  HUD has no stat row yet shows the core panel and nothing else.
-->
<fpdb_hud_package version="1.1">

  <!--
    The profile the user selects for a 6-max Hold'em table: the always-visible
    surface. The resolver adds the contextual panels below on top of it.
  -->
  <ss name="nlhe_6max_dynamic" rows="2" cols="2" xpad="1" ypad="0" rich_text="True" font_size="10" title_font_scale="0.82" heading_font_scale="0.60">

    <!--
      The panels. Each is a block of THIS profile, because that is what the
      resolver selects: it names a panel, and the seat window shows the block
      whose label is that name. The contextual panels carry the position
      binding "dynamic", a seat code no table ever has, so they stay hidden
      until a rule names them. `core`, the fallback, has no position binding
      and is therefore always visible.
    -->
    <block id="core" label="Core" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="n" popup="nlhe6_dynamic_core"
          hudbgcolor="#0F172A" hudprefix="H " tip="Hands seen" display_label="Hands"
          stat_loth="25" stat_locolor="#FF6B6B" stat_midcolor="#F2F4E6" stat_hith="200" stat_hicolor="#4ADE80"/>
    <stat _rowcol="(1,2)" _stat_name="vpip" popup="nlhe6_dynamic_core"
          hudbgcolor="#1E1B4B" hudprefix="VP " tip="Voluntarily put money in pot" display_label="VPIP"
          stat_loth="18" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="32" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="pfr" popup="nlhe6_dynamic_core"
          hudbgcolor="#1E1B4B" hudprefix="PR " tip="Preflop raise" display_label="PFR"
          stat_loth="12" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="26" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="three_B" popup="nlhe6_dynamic_core"
          hudbgcolor="#1E1B4B" hudprefix="3B " tip="Three-bet" display_label="3-bet"
          stat_loth="4" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="11" stat_hicolor="#FF6B6B"/>
    </block>

  <!-- Preflop: opening. -->
  <block id="preflop_open" label="Preflop · Unopened" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="steal" popup="nlhe6_dynamic_preflop" hudprefix="ST " tip="Steal attempt from the late seats" display_label="Steal" hudbgcolor="#1E1B4B" stat_loth="25" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="45" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="s_steal" popup="nlhe6_dynamic_preflop" hudprefix="SS " tip="Steal that took the blinds down" display_label="Steal success" hudbgcolor="#1E1B4B" stat_loth="15" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="35" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="open_limp" popup="nlhe6_dynamic_preflop" hudprefix="LP " tip="Open limp: entered the pot by calling" display_label="Open limp" hudbgcolor="#312E81" stat_loth="3" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="15" stat_hicolor="#FFD166"/>
    <stat _rowcol="(2,2)" _stat_name="cold_call" popup="nlhe6_dynamic_preflop" hudprefix="CC " tip="Cold call: called a raise without having money in" display_label="Cold call" hudbgcolor="#312E81" stat_loth="4" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="12" stat_hicolor="#FFD166"/>
  </block>

  <!-- Preflop: facing an open. -->
  <block id="preflop_facing_open" label="Preflop · Facing an open" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="three_B" popup="nlhe6_dynamic_preflop" hudprefix="3B " tip="Three-bet versus the open in front of them" display_label="3-bet vs open" hudbgcolor="#1E1B4B" stat_loth="4" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="12" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="cold_call" popup="nlhe6_dynamic_preflop" hudprefix="CC " tip="Cold call versus the open" display_label="Cold call" hudbgcolor="#312E81" stat_loth="4" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="14" stat_hicolor="#FFD166"/>
    <stat _rowcol="(2,1)" _stat_name="vpip" popup="nlhe6_dynamic_preflop" hudprefix="VP " tip="How often they enter any pot" display_label="VPIP" hudbgcolor="#0F172A" stat_loth="18" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="32" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="f_steal" popup="nlhe6_dynamic_preflop" hudprefix="FS " tip="Fold to a steal attempt" display_label="Fold to steal" hudbgcolor="#0F172A" stat_loth="50" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="75" stat_hicolor="#FF6B6B"/>
  </block>

  <!-- Preflop: facing a 3-bet after opening. -->
  <block id="preflop_facing_three_bet" label="Preflop · Facing a 3-bet" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="f_3bet" popup="nlhe6_dynamic_preflop" hudprefix="F3 " tip="Fold versus a three-bet" display_label="Fold to 3-bet" hudbgcolor="#1E1B4B" stat_loth="40" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="72" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="four_B" popup="nlhe6_dynamic_preflop" hudprefix="4B " tip="Four-bet: came back over the three-bet" display_label="4-bet" hudbgcolor="#312E81" stat_loth="2" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="8" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="f_4bet" popup="nlhe6_dynamic_preflop" hudprefix="F4 " tip="Fold versus a four-bet" display_label="Fold to 4-bet" hudbgcolor="#312E81" stat_loth="40" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="75" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="totalprofit" popup="nlhe6_dynamic_preflop" hudprefix="P " tip="Realized profit, not an EV-adjusted figure" display_label="Profit" hudbgcolor="#0F172A" stat_loth="-20000" stat_locolor="#FF6B6B" stat_midcolor="#F2F4E6" stat_hith="20000" stat_hicolor="#4ADE80"/>
  </block>

  <!-- Preflop: squeeze spots. -->
  <block id="preflop_squeeze" label="Preflop · Squeeze spot" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="squeeze" popup="nlhe6_dynamic_preflop" hudprefix="SQ " tip="Squeeze: raised after a raise was called" display_label="Squeeze" hudbgcolor="#1E1B4B" stat_loth="3" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="10" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="fold_vs_preflop_squeeze" popup="nlhe6_dynamic_preflop" hudprefix="FS " tip="Fold when somebody squeezed behind" display_label="Fold vs squeeze" hudbgcolor="#1E1B4B" stat_loth="45" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="75" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="call_vs_preflop_squeeze" popup="nlhe6_dynamic_preflop" hudprefix="CS " tip="Call versus a squeeze" display_label="Call squeeze" hudbgcolor="#312E81" stat_loth="10" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="35" stat_hicolor="#FFD166"/>
    <stat _rowcol="(2,2)" _stat_name="raise_vs_preflop_squeeze" popup="nlhe6_dynamic_preflop" hudprefix="RS " tip="Raise over a squeeze" display_label="Raise squeeze" hudbgcolor="#312E81" stat_loth="2" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="8" stat_hicolor="#FF6B6B"/>
  </block>

  <!-- Preflop: blind defence. -->
  <block id="blinds_defence" label="Preflop · Blind defence" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="f_BB_steal" popup="nlhe6_dynamic_preflop" hudprefix="FB " tip="Big blind folds to a steal" display_label="BB fold to steal" hudbgcolor="#1E1B4B" stat_loth="45" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="75" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="f_SB_steal" popup="nlhe6_dynamic_preflop" hudprefix="FS " tip="Small blind folds to a steal" display_label="SB fold to steal" hudbgcolor="#1E1B4B" stat_loth="60" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="85" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="three_bet_vs_steal" popup="nlhe6_dynamic_preflop" hudprefix="3S " tip="Three-bet versus a steal: the re-steal" display_label="3-bet vs steal" hudbgcolor="#312E81" stat_loth="6" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="18" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="call_vs_steal" popup="nlhe6_dynamic_preflop" hudprefix="CS " tip="Called the steal instead of folding or raising" display_label="Call vs steal" hudbgcolor="#312E81" stat_loth="15" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="40" stat_hicolor="#FFD166"/>
  </block>

  <!-- Preflop: stealing from the late seats. -->
  <block id="blinds_steal" label="Preflop · Stealing" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="steal" popup="nlhe6_dynamic_preflop" hudprefix="ST " tip="Steal attempt from the button, cutoff or small blind" display_label="Steal" hudbgcolor="#1E1B4B" stat_loth="25" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="45" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="s_steal" popup="nlhe6_dynamic_preflop" hudprefix="SS " tip="Steal that was not defended" display_label="Steal success" hudbgcolor="#1E1B4B" stat_loth="15" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="35" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="f_BB_steal" popup="nlhe6_dynamic_preflop" hudprefix="FB " tip="How often the big blind folds to a steal" display_label="BB fold to steal" hudbgcolor="#0F172A" stat_loth="45" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="75" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="f_SB_steal" popup="nlhe6_dynamic_preflop" hudprefix="FS " tip="How often the small blind folds to a steal" display_label="SB fold to steal" hudbgcolor="#0F172A" stat_loth="60" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="85" stat_hicolor="#FF6B6B"/>
  </block>

  <!-- Preflop: deep stacks. -->
  <block id="preflop_deep" label="Preflop · Deep stacks" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="steal" popup="nlhe6_dynamic_preflop" hudprefix="ST " tip="Steal attempt at a deep table" display_label="Steal" hudbgcolor="#1E1B4B" stat_loth="25" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="50" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="three_B" popup="nlhe6_dynamic_preflop" hudprefix="3B " tip="Three-bet at a deep table" display_label="3-bet" hudbgcolor="#1E1B4B" stat_loth="4" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="12" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="f_3bet" popup="nlhe6_dynamic_preflop" hudprefix="F3 " tip="Fold versus a three-bet at a deep table" display_label="Fold to 3-bet" hudbgcolor="#312E81" stat_loth="40" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="72" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="totalprofit" popup="nlhe6_dynamic_preflop" hudprefix="P " tip="Realized profit at a deep table" display_label="Profit" hudbgcolor="#0F172A" stat_loth="-20000" stat_locolor="#FF6B6B" stat_midcolor="#F2F4E6" stat_hith="20000" stat_hicolor="#4ADE80"/>
  </block>

  <!-- Single-raised pots: the preflop aggressor in position. -->
  <block id="srp_cbet_ip" label="SRP · PFR IP · Betting" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="cb1" popup="nlhe6_dynamic_postflop" hudprefix="CB " tip="Flop continuation bet" display_label="Flop c-bet" hudbgcolor="#0F172A" stat_loth="45" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="75" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="cb2" popup="nlhe6_dynamic_postflop" hudprefix="TB " tip="Turn barrel after betting the flop" display_label="Turn barrel" hudbgcolor="#0F172A" stat_loth="30" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="65" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="cb3" popup="nlhe6_dynamic_postflop" hudprefix="RB " tip="River barrel after betting flop and turn" display_label="River barrel" hudbgcolor="#0F172A" stat_loth="20" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="60" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="triple_barrel" popup="nlhe6_dynamic_postflop" hudprefix="3X " tip="Barrelled every street" display_label="3-street barrel" hudbgcolor="#312E81" stat_loth="5" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="25" stat_hicolor="#FF6B6B"/>
  </block>

  <!-- Single-raised pots: the preflop aggressor out of position. -->
  <block id="srp_cbet_oop" label="SRP · PFR OOP · Betting" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="cb1" popup="nlhe6_dynamic_postflop" hudprefix="CB " tip="Flop continuation bet, out of position" display_label="Flop c-bet OOP" hudbgcolor="#0F172A" stat_loth="40" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="70" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="cb2" popup="nlhe6_dynamic_postflop" hudprefix="TB " tip="Turn barrel, out of position" display_label="Turn barrel" hudbgcolor="#0F172A" stat_loth="25" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="60" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="cb3" popup="nlhe6_dynamic_postflop" hudprefix="RB " tip="River barrel, out of position" display_label="River barrel" hudbgcolor="#0F172A" stat_loth="15" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="55" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="check_raise_frequency" popup="nlhe6_dynamic_postflop" hudprefix="CR " tip="Check-raise: the out-of-position counter-attack" display_label="Check-raise" hudbgcolor="#312E81" stat_loth="5" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="20" stat_hicolor="#FF6B6B"/>
  </block>

  <!-- Single-raised pots: defending the c-bet in position. -->
  <block id="srp_face_cbet_ip" label="SRP · Caller IP · Facing the bet" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="fold_vs_flop_cbet" popup="nlhe6_dynamic_postflop" hudprefix="F " tip="Folded to the flop c-bet" display_label="Fold vs c-bet" hudbgcolor="#0F172A" stat_loth="35" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="70" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="call_vs_flop_cbet" popup="nlhe6_dynamic_postflop" hudprefix="C " tip="Called the flop c-bet" display_label="Call vs c-bet" hudbgcolor="#0F172A" stat_loth="20" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="55" stat_hicolor="#FFD166"/>
    <stat _rowcol="(2,1)" _stat_name="raise_vs_flop_cbet" popup="nlhe6_dynamic_postflop" hudprefix="R " tip="Raised the flop c-bet" display_label="Raise c-bet" hudbgcolor="#312E81" stat_loth="5" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="20" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="float_turn" popup="nlhe6_dynamic_postflop" hudprefix="FL " tip="Floated: called the flop to take it away later" display_label="Turn float" hudbgcolor="#312E81" stat_loth="5" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="25" stat_hicolor="#FF6B6B"/>
  </block>

  <!-- Single-raised pots: defending the c-bet out of position. -->
  <block id="srp_face_cbet_oop" label="SRP · Caller OOP · Facing the bet" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="fold_vs_flop_cbet" popup="nlhe6_dynamic_postflop" hudprefix="F " tip="Folded to the flop c-bet, out of position" display_label="Fold vs c-bet" hudbgcolor="#0F172A" stat_loth="40" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="72" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="call_vs_flop_cbet" popup="nlhe6_dynamic_postflop" hudprefix="C " tip="Called the flop c-bet, out of position" display_label="Call vs c-bet" hudbgcolor="#0F172A" stat_loth="20" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="55" stat_hicolor="#FFD166"/>
    <stat _rowcol="(2,1)" _stat_name="raise_vs_flop_cbet" popup="nlhe6_dynamic_postflop" hudprefix="R " tip="Raised the flop c-bet, out of position" display_label="Raise vs c-bet" hudbgcolor="#312E81" stat_loth="5" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="20" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="check_raise_frequency" popup="nlhe6_dynamic_postflop" hudprefix="CR " tip="Check-raised instead of leading out" display_label="Check-raise" hudbgcolor="#312E81" stat_loth="5" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="20" stat_hicolor="#FF6B6B"/>
  </block>

  <!-- Single-raised pots: probing after the aggressor checked. -->
  <block id="srp_probe_ip" label="SRP · Checked to · Turn and river" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="probe_bet_turn" popup="nlhe6_dynamic_postflop" hudprefix="PT " tip="Probe bet on the turn after the flop checked through" display_label="Turn probe" hudbgcolor="#0F172A" stat_loth="25" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="60" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="probe_bet_river" popup="nlhe6_dynamic_postflop" hudprefix="PR " tip="Probe bet on the river" display_label="River probe" hudbgcolor="#0F172A" stat_loth="20" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="55" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="f_cb1" popup="nlhe6_dynamic_postflop" hudprefix="FC " tip="How often they fold to a flop c-bet" display_label="Fold vs c-bet" hudbgcolor="#312E81" stat_loth="35" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="65" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="a_freq2" popup="nlhe6_dynamic_postflop" hudprefix="A2 " tip="Aggression frequency on the turn" display_label="Turn aggression" hudbgcolor="#312E81" stat_loth="25" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="55" stat_hicolor="#FF6B6B"/>
  </block>

  <!-- 3-bet pots, in position. -->
  <block id="threebet_pot_ip" label="3-bet pot · IP" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="three_B_flop" popup="nlhe6_dynamic_threebet" hudprefix="3F " tip="Three-bet on the flop in a 3-bet pot" display_label="Flop 3-bet" hudbgcolor="#1E1B4B" stat_loth="3" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="12" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="cb1" popup="nlhe6_dynamic_threebet" hudprefix="CB " tip="Flop continuation bet in a 3-bet pot" display_label="Flop c-bet" hudbgcolor="#1E1B4B" stat_loth="40" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="70" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="fold_to_three_B_flop" popup="nlhe6_dynamic_threebet" hudprefix="F3 " tip="Folded to the flop three-bet" display_label="Fold vs 3-bet" hudbgcolor="#312E81" stat_loth="40" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="72" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="f_cb1" popup="nlhe6_dynamic_threebet" hudprefix="FC " tip="Folded to the flop c-bet in a 3-bet pot" display_label="Fold vs c-bet" hudbgcolor="#312E81" stat_loth="35" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="65" stat_hicolor="#FF6B6B"/>
  </block>

  <!-- 3-bet pots, out of position. -->
  <block id="threebet_pot_oop" label="3-bet pot · OOP" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="three_B_flop" popup="nlhe6_dynamic_threebet" hudprefix="3F " tip="Three-bet on the flop, out of position" display_label="Flop 3-bet" hudbgcolor="#1E1B4B" stat_loth="3" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="12" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="cb1" popup="nlhe6_dynamic_threebet" hudprefix="CB " tip="Flop c-bet, out of position" display_label="Flop c-bet" hudbgcolor="#1E1B4B" stat_loth="35" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="65" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="check_raise_frequency" popup="nlhe6_dynamic_threebet" hudprefix="CR " tip="Check-raise in a 3-bet pot" display_label="Check-raise" hudbgcolor="#312E81" stat_loth="4" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="18" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="fold_to_three_B_flop" popup="nlhe6_dynamic_threebet" hudprefix="F3 " tip="Folded to the flop three-bet" display_label="Fold vs 3-bet" hudbgcolor="#312E81" stat_loth="40" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="72" stat_hicolor="#FF6B6B"/>
  </block>

  <!-- 4-bet pots. -->
  <block id="fourbet_pot" label="4-bet pot" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="four_B_flop" popup="nlhe6_dynamic_fourbet" hudprefix="4F " tip="Flop four-bet in an already 4-bet pot" display_label="Flop 4-bet" hudbgcolor="#312E81" stat_loth="2" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="10" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="cb1" popup="nlhe6_dynamic_fourbet" hudprefix="CB " tip="Flop continuation bet in a 4-bet pot" display_label="Flop c-bet" hudbgcolor="#312E81" stat_loth="35" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="70" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="fold_to_cbet_flop" popup="nlhe6_dynamic_fourbet" hudprefix="FC " tip="Folded to the flop c-bet" display_label="Fold vs c-bet" hudbgcolor="#0F172A" stat_loth="35" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="70" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="totalprofit" popup="nlhe6_dynamic_fourbet" hudprefix="P " tip="Realized profit in 4-bet pots" display_label="Profit" hudbgcolor="#0F172A" stat_loth="-30000" stat_locolor="#FF6B6B" stat_midcolor="#F2F4E6" stat_hith="30000" stat_hicolor="#4ADE80"/>
  </block>

  <!-- Short stacks. -->
  <block id="ssh_stack" label="Short stack" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="vpip" popup="nlhe6_dynamic_stacks" hudprefix="VP " tip="How often a short stack enters the pot" display_label="VPIP" hudbgcolor="#1E1B4B" stat_loth="15" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="35" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="pfr" popup="nlhe6_dynamic_stacks" hudprefix="PR " tip="How often a short stack raises preflop" display_label="PFR" hudbgcolor="#1E1B4B" stat_loth="10" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="28" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="three_B" popup="nlhe6_dynamic_stacks" hudprefix="3B " tip="Three-bet frequency at a short stack" display_label="3-bet" hudbgcolor="#312E81" stat_loth="4" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="14" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="totalprofit" popup="nlhe6_dynamic_stacks" hudprefix="P " tip="Realized profit at a short stack" display_label="Profit" hudbgcolor="#0F172A" stat_loth="-20000" stat_locolor="#FF6B6B" stat_midcolor="#F2F4E6" stat_hith="20000" stat_hicolor="#4ADE80"/>
  </block>

  <!-- River overbets. -->
  <block id="overbet_river" label="River · Facing an overbet" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="cb3" popup="nlhe6_dynamic_sizing" hudprefix="RB " tip="River bet after betting the flop and turn" display_label="River barrel" hudbgcolor="#1E1B4B" stat_loth="20" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="60" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="f_cb3" popup="nlhe6_dynamic_sizing" hudprefix="FR " tip="Folded to the river bet" display_label="Fold vs river bet" hudbgcolor="#1E1B4B" stat_loth="35" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="70" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,1)" _stat_name="wtsd" popup="nlhe6_dynamic_sizing" hudprefix="WS " tip="Went to showdown: how often they look you up" display_label="Went to SD" hudbgcolor="#312E81" stat_loth="22" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="35" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="totalprofit" popup="nlhe6_dynamic_sizing" hudprefix="P " tip="Realized profit in these pots" display_label="Profit" hudbgcolor="#0F172A" stat_loth="-30000" stat_locolor="#FF6B6B" stat_midcolor="#F2F4E6" stat_hith="30000" stat_hicolor="#4ADE80"/>
  </block>

  <!-- Facing a small bet. -->
  <block id="minbet_faced" label="Facing a small bet" position="dynamic" rows="2" cols="2" title_bgcolor="#312E81" title_fgcolor="#E6EDF3">
    <stat _rowcol="(1,1)" _stat_name="f_cb1" popup="nlhe6_dynamic_sizing" hudprefix="FC " tip="Folded to a small flop bet" display_label="Fold vs small bet" hudbgcolor="#1E1B4B" stat_loth="25" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="60" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,2)" _stat_name="call_vs_flop_cbet" popup="nlhe6_dynamic_sizing" hudprefix="C " tip="Called a small flop bet" display_label="Call small bet" hudbgcolor="#1E1B4B" stat_loth="25" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="60" stat_hicolor="#FFD166"/>
    <stat _rowcol="(2,1)" _stat_name="raise_vs_flop_cbet" popup="nlhe6_dynamic_sizing" hudprefix="R " tip="Raised a small flop bet" display_label="Raise small bet" hudbgcolor="#312E81" stat_loth="5" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="22" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="wtsd" popup="nlhe6_dynamic_sizing" hudprefix="WS " tip="Went to showdown in these pots" display_label="Went to SD" hudbgcolor="#0F172A" stat_loth="22" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="35" stat_hicolor="#FF6B6B"/>
  </block>

  </ss>

  <popup_windows>
    <pu pu_name="nlhe6_dynamic_core" pu_class="ModernSubmenu" pu_title="{player}: dynamic context">
      <pu_stat pu_stat_name="playername"/>
      <pu_stat pu_stat_name="n"/>
      <pu_stat pu_stat_name="vpip"/>
      <pu_stat pu_stat_name="pfr"/>
      <pu_stat pu_stat_name="three_B"/>
      <pu_stat pu_stat_name="totalprofit"/>
      <pu_stat pu_stat_name="bbper100"/>
      <pu_stat pu_stat_name="Preflop" pu_stat_submenu="nlhe6_dynamic_preflop"/>
      <pu_stat pu_stat_name="Single-raised pot" pu_stat_submenu="nlhe6_dynamic_postflop"/>
      <pu_stat pu_stat_name="3-bet pot" pu_stat_submenu="nlhe6_dynamic_threebet"/>
      <pu_stat pu_stat_name="4-bet pot" pu_stat_submenu="nlhe6_dynamic_fourbet"/>
      <pu_stat pu_stat_name="Sizing" pu_stat_submenu="nlhe6_dynamic_sizing"/>
      <pu_stat pu_stat_name="Stacks" pu_stat_submenu="nlhe6_dynamic_stacks"/>
    </pu>

    <pu pu_name="nlhe6_dynamic_preflop" pu_class="ModernSubmenu" pu_title="{player}: preflop">
      <!--
        vpip, pfr and 3-bet are on the popup that opened this one, so they are
        not repeated here: a page that costs a click has to be worth it (#370).
      -->
      <pu_stat pu_stat_name="playername"/>
      <pu_stat pu_stat_name="n"/>
      <pu_stat pu_stat_name="f_3bet"/>
      <pu_stat pu_stat_name="four_B"/>
      <pu_stat pu_stat_name="f_4bet"/>
      <pu_stat pu_stat_name="steal"/>
      <pu_stat pu_stat_name="s_steal"/>
      <pu_stat pu_stat_name="f_BB_steal"/>
      <pu_stat pu_stat_name="f_SB_steal"/>
      <pu_stat pu_stat_name="cold_call"/>
      <pu_stat pu_stat_name="open_limp"/>
      <pu_stat pu_stat_name="squeeze"/>
      <pu_stat pu_stat_name="totalprofit"/>
      <pu_stat pu_stat_name="Opening by position" pu_stat_submenu="preflop_rfi"/>
      <pu_stat pu_stat_name="Blind defence" pu_stat_submenu="preflop_blind_defence"/>
      <pu_stat pu_stat_name="Full preflop pack" pu_stat_submenu="preflop"/>
    </pu>

    <pu pu_name="nlhe6_dynamic_postflop" pu_class="ModernSubmenu" pu_title="{player}: single-raised pot">
      <pu_stat pu_stat_name="playername"/>
      <pu_stat pu_stat_name="n"/>
      <pu_stat pu_stat_name="cb1"/>
      <pu_stat pu_stat_name="cb2"/>
      <pu_stat pu_stat_name="cb3"/>
      <pu_stat pu_stat_name="f_cb1"/>
      <pu_stat pu_stat_name="f_cb2"/>
      <pu_stat pu_stat_name="a_freq_123"/>
      <pu_stat pu_stat_name="wtsd"/>
      <pu_stat pu_stat_name="totalprofit"/>
      <pu_stat pu_stat_name="Flop aggression" pu_stat_submenu="srp_flop_aggression"/>
      <pu_stat pu_stat_name="Turn" pu_stat_submenu="srp_turn"/>
      <pu_stat pu_stat_name="River" pu_stat_submenu="srp_river"/>
      <pu_stat pu_stat_name="Full SRP pack" pu_stat_submenu="srp"/>
    </pu>

    <pu pu_name="nlhe6_dynamic_threebet" pu_class="ModernSubmenu" pu_title="{player}: 3-bet pot">
      <pu_stat pu_stat_name="three_B_flop"/>
      <pu_stat pu_stat_name="three_B_turn"/>
      <pu_stat pu_stat_name="three_B_river"/>
      <pu_stat pu_stat_name="fold_to_three_B_flop"/>
      <pu_stat pu_stat_name="totalprofit"/>
      <pu_stat pu_stat_name="bbper100"/>
      <pu_stat pu_stat_name="Full 3-bet pot pack" pu_stat_submenu="threebet_pot"/>
    </pu>

    <pu pu_name="nlhe6_dynamic_fourbet" pu_class="ModernSubmenu" pu_title="{player}: 4-bet pot">
      <pu_stat pu_stat_name="four_B"/>
      <pu_stat pu_stat_name="four_B_flop"/>
      <pu_stat pu_stat_name="four_B_turn"/>
      <pu_stat pu_stat_name="four_B_river"/>
      <pu_stat pu_stat_name="fold_vs_4bet"/>
      <pu_stat pu_stat_name="totalprofit"/>
      <pu_stat pu_stat_name="bbper100"/>
      <pu_stat pu_stat_name="Full 4-bet pot pack" pu_stat_submenu="fourbet_pot"/>
    </pu>

    <pu pu_name="nlhe6_dynamic_stacks" pu_class="ModernSubmenu" pu_title="{player}: stack depth">
      <pu_stat pu_stat_name="n"/>
      <pu_stat pu_stat_name="f_3bet"/>
      <pu_stat pu_stat_name="f_4bet"/>
      <pu_stat pu_stat_name="totalprofit"/>
      <pu_stat pu_stat_name="bbper100"/>
      <pu_stat pu_stat_name="Stack depth pack" pu_stat_submenu="preflop_stacks"/>
    </pu>

    <pu pu_name="nlhe6_dynamic_sizing" pu_class="ModernSubmenu" pu_title="{player}: bet sizing">
      <pu_stat pu_stat_name="n"/>
      <pu_stat pu_stat_name="cb1"/>
      <pu_stat pu_stat_name="cb2"/>
      <pu_stat pu_stat_name="cb3"/>
      <pu_stat pu_stat_name="f_cb1"/>
      <pu_stat pu_stat_name="f_cb2"/>
      <pu_stat pu_stat_name="a_freq1"/>
      <pu_stat pu_stat_name="a_freq2"/>
      <pu_stat pu_stat_name="a_freq3"/>
      <pu_stat pu_stat_name="wtsd"/>
      <pu_stat pu_stat_name="totalprofit"/>
      <pu_stat pu_stat_name="Preflop sizing" pu_stat_submenu="preflop_sizing"/>
    </pu>
  </popup_windows>

  <!-- Bind normal-speed Winamax Hold'em to this profile. Keep fast-fold
       selection separate: it uses its dedicated fastfold_nlhe profile. -->

  <!--
    The rules that make the blocks above appear and disappear. `source="builtin"`
    reads the shipped library (hud_situation.d/core.json); `profile` scopes it to
    this package's profile, so importing the Dynamic HUD does not change what any
    other profile does; `fallback="core"` keeps the core block on screen when no
    rule matches. Profile-scoped sections coexist, so importing this package
    does not replace the PLO package's dynamic-panel rules.
  -->
  <hud_panel_rules enabled="true" source="builtin" fallback="core" profile="nlhe_6max_dynamic"/>

</fpdb_hud_package>
