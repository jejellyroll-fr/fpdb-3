<?xml version="1.0" encoding="UTF-8"?>
<!--
  FPDB Basic — the starter HUD for No Limit Hold'em 6-max.

  Who it is for: someone who has just imported their first hands and wants a
  readable HUD, not a configuration project.

  What it shows: the eight numbers that answer "who am I playing against" —
  hands seen, VPIP, PFR, 3-bet, fold to 3-bet, flop c-bet and fold to flop
  c-bet. Two popups carry the rest: preflop and postflop.

  What it deliberately does not use: no analytics definition, no dynamic panel,
  no popup pack. Every stat here is a native column stat, so the HUD renders
  at full speed and nothing depends on the analytics tables having been rebuilt.

  How to use it: Preferences > HUD > Import, then pick "nlhe_6max_basic" as the
  profile for your Hold'em tables. The package does NOT bind itself to the
  game: importing a reference HUD must never silently replace the HUD you
  already have.

  Reading a number: the sample sits next to the name (H ) because a percentage
  over four hands says nothing. Under 25 hands the name is red.
-->
<fpdb_hud_package version="1.1">

  <ss name="nlhe_6max_basic" rows="2" cols="4" xpad="1" ypad="0" rich_text="True" font_size="10">

    <stat _rowcol="(1,1)" _stat_name="playername" popup="nlhe6_basic_preflop"
          hudbgcolor="#0F172A" hudcolor="#E6EDF3" click="open_comment_dialog"
          tip="Player name. Double-click to open their notes."/>
    <stat _rowcol="(1,2)" _stat_name="n" popup="nlhe6_basic_preflop"
          hudbgcolor="#0F172A" hudprefix="H " tip="Hands seen: the sample every other number is based on"
          stat_loth="25" stat_locolor="#FF6B6B" stat_midcolor="#F2F4E6" stat_hith="200" stat_hicolor="#4ADE80"/>
    <stat _rowcol="(1,3)" _stat_name="vpip" popup="nlhe6_basic_preflop"
          hudbgcolor="#1E1B4B" hudprefix="VP " tip="Voluntarily put money in pot: how often they enter a pot at all"
          stat_loth="18" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="32" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,4)" _stat_name="pfr" popup="nlhe6_basic_preflop"
          hudbgcolor="#1E1B4B" hudprefix="PR " tip="Preflop raise: how often they raise rather than just call"
          stat_loth="12" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="26" stat_hicolor="#FF6B6B"/>

    <stat _rowcol="(2,1)" _stat_name="three_B" popup="nlhe6_basic_preflop"
          hudbgcolor="#1E1B4B" hudprefix="3B " tip="Three-bet: re-raise of a single raise"
          stat_loth="4" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="11" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="f_3bet" popup="nlhe6_basic_preflop"
          hudbgcolor="#1E1B4B" hudprefix="F3 " tip="Fold to three-bet: how often they give up after raising"
          stat_loth="40" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="70" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,3)" _stat_name="cb1" popup="nlhe6_basic_postflop"
          hudbgcolor="#0F172A" hudprefix="CB " tip="Flop continuation bet: how often the preflop raiser bets the flop"
          stat_loth="45" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="75" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,4)" _stat_name="f_cb1" popup="nlhe6_basic_postflop"
          hudbgcolor="#0F172A" hudprefix="FC " tip="Fold to flop continuation bet: how often they fold when facing the c-bet"
          stat_loth="35" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="65" stat_hicolor="#FF6B6B"/>

  </ss>

  <popup_windows>
    <!-- The preflop popup: opening, defence and the raising war. -->
    <pu pu_name="nlhe6_basic_preflop" pu_class="ModernSubmenu" pu_title="{player}: preflop">
      <pu_stat pu_stat_name="playername"/>
      <pu_stat pu_stat_name="n"/>
      <pu_stat pu_stat_name="vpip"/>
      <pu_stat pu_stat_name="pfr"/>
      <pu_stat pu_stat_name="vpip_pfr_ratio"/>
      <pu_stat pu_stat_name="three_B"/>
      <pu_stat pu_stat_name="f_3bet"/>
      <pu_stat pu_stat_name="four_B"/>
      <pu_stat pu_stat_name="steal"/>
      <pu_stat pu_stat_name="f_steal"/>
      <pu_stat pu_stat_name="f_BB_steal"/>
      <pu_stat pu_stat_name="limp"/>
      <pu_stat pu_stat_name="cold_call"/>
      <pu_stat pu_stat_name="squeeze"/>
      <pu_stat pu_stat_name="totalprofit"/>
      <pu_stat pu_stat_name="bbper100"/>
    </pu>

    <!-- The postflop popup: streets, aggression and results. -->
    <pu pu_name="nlhe6_basic_postflop" pu_class="ModernSubmenu" pu_title="{player}: postflop">
      <pu_stat pu_stat_name="playername"/>
      <pu_stat pu_stat_name="n"/>
      <pu_stat pu_stat_name="cb1"/>
      <pu_stat pu_stat_name="cb2"/>
      <pu_stat pu_stat_name="cb3"/>
      <pu_stat pu_stat_name="f_cb1"/>
      <pu_stat pu_stat_name="f_cb2"/>
      <pu_stat pu_stat_name="a_freq1"/>
      <pu_stat pu_stat_name="a_freq2"/>
      <pu_stat pu_stat_name="a_freq3"/>
      <pu_stat pu_stat_name="a_freq_123"/>
      <pu_stat pu_stat_name="agg_fact"/>
      <pu_stat pu_stat_name="wwsf"/>
      <pu_stat pu_stat_name="wtsd"/>
      <pu_stat pu_stat_name="wmsd"/>
      <pu_stat pu_stat_name="totalprofit"/>
      <pu_stat pu_stat_name="bbper100"/>
    </pu>
  </popup_windows>

</fpdb_hud_package>
