<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast-Fold HUD for Pot Limit Omaha (Winamax Go Fast / Escape, Zoom, Rush).

  Import it from Preferences > HUD > Import. It adds the profile, its popups,
  and a rule that applies it only where speed="fast" — your ordinary Omaha
  cash tables keep the profile they already use.

  Same idea as the Hold'em package, different numbers: Omaha ranges are wider,
  so the thresholds that mark somebody as loose or tight sit much higher, and
  the postflop row carries more weight because far more hands see a flop.
-->
<fpdb_hud_package version="1.1">

  <ss name="fastfold_plo" rows="4" cols="4" xpad="1" ypad="0" rich_text="True" font_size="10">

    <!-- Row 1: who they are, and how much to trust the rest of the block. -->
    <stat _rowcol="(1,1)" _stat_name="playershort" popup="fastfold_plo_preflop"
          hudbgcolor="#0F172A" hudcolor="#98FFB0" tip="Player" click="open_comment_dialog"/>
    <stat _rowcol="(1,2)" _stat_name="n" popup="fastfold_plo_preflop"
          hudbgcolor="#0F172A" hudprefix="H " tip="Hands seen"
          stat_loth="25" stat_locolor="#FF6B6B" stat_midcolor="#F2F4E6" stat_hith="150" stat_hicolor="#4ADE80"/>
    <stat _rowcol="(1,3)" _stat_name="vpip" popup="fastfold_plo_preflop"
          hudbgcolor="#1E1B4B" hudprefix="VP " tip="Voluntarily put money in pot"
          stat_loth="28" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="45" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(1,4)" _stat_name="pfr" popup="fastfold_plo_preflop"
          hudbgcolor="#1E1B4B" hudprefix="PR " tip="Preflop raise"
          stat_loth="16" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="28" stat_hicolor="#FF6B6B"/>

    <!-- Row 2: the raising war. -->
    <stat _rowcol="(2,1)" _stat_name="three_B" popup="fastfold_plo_preflop"
          hudbgcolor="#1E1B4B" hudprefix="3B " tip="Three-bet"
          stat_loth="4" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="9" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,2)" _stat_name="f_3bet" popup="fastfold_plo_preflop"
          hudbgcolor="#1E1B4B" hudprefix="F3 " tip="Fold to three-bet"
          stat_loth="40" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="65" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,3)" _stat_name="steal" popup="fastfold_plo_preflop"
          hudbgcolor="#1E1B4B" hudprefix="ST " tip="Steal attempt"
          stat_loth="25" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="42" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(2,4)" _stat_name="f_steal" popup="fastfold_plo_preflop"
          hudbgcolor="#1E1B4B" hudprefix="FS " tip="Fold to steal"
          stat_loth="45" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="70" stat_hicolor="#FF6B6B"/>

    <!-- Row 3: Omaha sees a lot of flops, so this row earns its space. -->
    <stat _rowcol="(3,1)" _stat_name="cb1" popup="fastfold_plo_postflop"
          hudbgcolor="#312E81" hudprefix="CB " tip="Flop continuation bet"
          stat_loth="40" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="65" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(3,2)" _stat_name="f_cb1" popup="fastfold_plo_postflop"
          hudbgcolor="#312E81" hudprefix="FC " tip="Fold to flop continuation bet"
          stat_loth="35" stat_locolor="#4ADE80" stat_midcolor="#F2F4E6" stat_hith="60" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(3,3)" _stat_name="wwsf" popup="fastfold_plo_postflop"
          hudbgcolor="#312E81" hudprefix="WW " tip="Won when saw flop"
          stat_loth="42" stat_locolor="#FF6B6B" stat_midcolor="#F2F4E6" stat_hith="50" stat_hicolor="#4ADE80"/>
    <stat _rowcol="(3,4)" _stat_name="limp" popup="fastfold_plo_preflop"
          hudbgcolor="#312E81" hudprefix="LP " tip="Limp"
          stat_loth="4" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="15" stat_hicolor="#FFD166"/>

    <!-- Row 4: aggression by street, then showdown. -->
    <stat _rowcol="(4,1)" _stat_name="a_freq1" popup="fastfold_plo_postflop"
          hudbgcolor="#0F172A" hudprefix="F " tip="Flop aggression frequency"
          stat_loth="30" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="52" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(4,2)" _stat_name="a_freq2" popup="fastfold_plo_postflop"
          hudbgcolor="#0F172A" hudprefix="T " tip="Turn aggression frequency"
          stat_loth="28" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="50" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(4,3)" _stat_name="a_freq3" popup="fastfold_plo_postflop"
          hudbgcolor="#0F172A" hudprefix="R " tip="River aggression frequency"
          stat_loth="25" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="45" stat_hicolor="#FF6B6B"/>
    <stat _rowcol="(4,4)" _stat_name="wtsd" popup="fastfold_plo_postflop"
          hudbgcolor="#0F172A" hudprefix="WS " tip="Went to showdown"
          stat_loth="26" stat_locolor="#4CC9F0" stat_midcolor="#F2F4E6" stat_hith="36" stat_hicolor="#FF6B6B"/>

  </ss>

  <popup_windows>
    <pu pu_name="fastfold_plo_preflop" pu_class="default">
      <pu_stat pu_stat_name="playername"/>
      <pu_stat pu_stat_name="n"/>
      <pu_stat pu_stat_name="vpip"/>
      <pu_stat pu_stat_name="pfr"/>
      <pu_stat pu_stat_name="three_B"/>
      <pu_stat pu_stat_name="f_3bet"/>
      <pu_stat pu_stat_name="four_B"/>
      <pu_stat pu_stat_name="steal"/>
      <pu_stat pu_stat_name="f_steal"/>
      <pu_stat pu_stat_name="f_BB_steal"/>
      <pu_stat pu_stat_name="f_SB_steal"/>
      <pu_stat pu_stat_name="limp"/>
      <pu_stat pu_stat_name="cold_call"/>
      <pu_stat pu_stat_name="squeeze"/>
      <pu_stat pu_stat_name="profit100"/>
    </pu>
    <pu pu_name="fastfold_plo_postflop" pu_class="default">
      <pu_stat pu_stat_name="playername"/>
      <pu_stat pu_stat_name="n"/>
      <pu_stat pu_stat_name="cb1"/>
      <pu_stat pu_stat_name="cb2"/>
      <pu_stat pu_stat_name="cb3"/>
      <pu_stat pu_stat_name="f_cb1"/>
      <pu_stat pu_stat_name="f_cb2"/>
      <pu_stat pu_stat_name="a_freq1"/>
      <pu_stat pu_stat_name="a_freq2"/>
      <pu_stat pu_stat_name="a_freq3"/>
      <pu_stat pu_stat_name="a_freq_123"/>
      <pu_stat pu_stat_name="agg_fact"/>
      <pu_stat pu_stat_name="wwsf"/>
      <pu_stat pu_stat_name="wtsd"/>
      <pu_stat pu_stat_name="wmsd"/>
      <pu_stat pu_stat_name="profit100"/>
    </pu>
  </popup_windows>

  <!--
    One rule per Omaha category, so a Fast-Fold table gets this profile whether
    the pool deals Omaha high or hi/lo. Ordinary Omaha tables are untouched.
  -->
  <hud_profile_rules>
    <hud_profile_rule id="fastfold_plo" profile="fastfold_plo"
                      game="omahahi" game_type="ring" speed="fast" priority="50"/>
    <hud_profile_rule id="fastfold_plo_hilo" profile="fastfold_plo"
                      game="omahahilo" game_type="ring" speed="fast" priority="50"/>
    <hud_profile_rule id="fastfold_plo5" profile="fastfold_plo"
                      game="5_omahahi" game_type="ring" speed="fast" priority="50"/>
  </hud_profile_rules>

</fpdb_hud_package>
