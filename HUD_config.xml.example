    <supported_databases>
        <!-- <database db_server="mysql" db_user="fpdbuser" db_pass="YOUR MYSQL PASSWORD" db_name="fpdb" db_ip="localhost"></database> -->
             <database db_server="sqlite" db_name="fpdb.db3" db_ip="localhost" db_user="fpdb" db_pass="fpdb"/>
        <!-- <database db_server="postgresql" db_user="fpdb" db_pass="YOUR POSTGRES PASSWORD" db_name="fpdb" db_ip="localhost" ></database> -->
    </supported_databases>
    <!-- HUD profile rules: choose which stat set (HUD profile) a table gets,
         the way PokerTracker's "Profile Select" tab does.

         Each <hud_profile_rule> narrows the table context; "all" matches
         anything:
           site       room name as it appears in <supported_sites>, or "all"
           game       Gametypes.category (holdem, omahahi, aof_omaha, ...)
           game_type  "ring", "tour", or "all"
           limit      Gametypes.limitType (nl, pl, fl, cn), or "all"
           seats      table size (Gametypes.maxSeats), or "all"
           players    players actually dealt into the hand, or "all"
           speed      "normal", "fast", or "all"
           profile    the <ss name="..."> stat set to use
           priority   optional; higher wins between equally specific rules

         The most specific matching rule wins; ties break on priority, then on
         the order the rules appear here. When no rule matches, the profile
         from <supported_games> is used, so an empty
         section changes nothing.

         HUD positions are remembered per (site, game, game_type, seats,
         profile, layout). Two games that resolve to different profiles
         therefore keep their own window placement even when the room files
         them under a single layout set, as some rooms do.

         Example: give a room's 6-max AoF Omaha tables their own profile
         while every other table keeps the default.
           <hud_profile_rule site="YOUR SITE" game="aof_omaha" seats="6" profile="aof_advanced"/>

         The GUI writes this section from HUD Preferences -> Profile Select;
         this comment is kept outside the element so editing it there does not
         throw the documentation away. -->
    <hud_profile_rules>
    </hud_profile_rules>

</FreePokerToolsConfig><!-- IMPORTANT: Please note that fpdb stores your email password in clear text.
So do not post a config containing a password on the Internet or anywhere else without removing the password! -->
