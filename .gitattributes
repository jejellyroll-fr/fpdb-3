# uv.lock is generated by `uv lock` and stays in version control on purpose:
# .gitignore leaves it un-ignored because this project ships binaries, and
# `uv run` -- used by the Makefile, run_tests.sh and the documented tooling --
# resolves against it. Dropping it would cost reproducible builds.
#
# It is also 4 700 lines of machine output, which buried the six meaningful
# lines of a dependency change under a full re-resolution. Marking it generated
# collapses it by default in pull-request diffs and keeps it out of the
# language statistics, without weakening the guarantee above: the content is
# still versioned, still reviewable on demand, and still diffable with
# `git diff --text -- uv.lock`.
uv.lock linguist-generated=true -diff
