#: fpdb_3_legacy/live_capture_consent.py
msgid ""
"fpdb loads a small library of its own into the SwC Poker client: injected "
"into the running client on Windows, preloaded when fpdb launches the client "
"on macOS and Linux. Inside the client, it reads the table traffic after the "
"client has decrypted it, and writes it to a file fpdb imports. It stays "
"loaded until the client exits."
msgstr ""

#: fpdb_3_legacy/live_capture_consent.py
msgid ""
"fpdb records the network packets exchanged by the CoinPoker client, with "
"administrator rights (tcpdump, pkexec or a UAC prompt), and rebuilds the "
"hands from them. It reads the traffic only; it loads nothing into the client."
msgstr ""

