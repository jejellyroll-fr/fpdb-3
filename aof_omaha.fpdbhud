<?xml version="1.0" ?>
<fpdb_hud_package version="1.6">
    <ss name="aof_default" rows="4" cols="4" xpad="1" ypad="0">
        <stat _rowcol="(1,1)" _stat_name="playershort" popup="aof_profile" hudprefix="" hudsuffix="" tip="" click="open_comment_dialog" hudcolor="#98FFB0"/>
        <stat _rowcol="(1,2)" _stat_name="n" popup="aof_profile" hudprefix="H " hudsuffix="" tip="" click=""/>
