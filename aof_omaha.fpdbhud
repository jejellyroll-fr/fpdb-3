<?xml version="1.0" ?>
<fpdb_hud_package version="1.1">
    <!-- All-in or Fold Omaha.

         The game deals the flop before anyone acts and gives each player one
         decision, once, for their whole stack. The ordinary Omaha profile
         would label that decision "preflop", a street this game does not
         have, and invite comparison with ranges from a game that does.

         The <game> binding below is what an <ss> alone cannot carry: without
         it the profile is installed but nothing points at it, and the HUD
         still refuses to start for the category. -->
    <ss name="aof_default" rows="3" cols="2" xpad="1" ypad="0">
        <stat _rowcol="(1,1)" _stat_name="playershort" popup="default" tip="" click="" hudcolor="#98FFB0" hudprefix="" hudsuffix=""/>
        <stat _rowcol="(1,2)" _stat_name="n" popup="default" tip="" click=""/>
        <stat _rowcol="(2,1)" _stat_name="aof_allin" popup="default" tip="" click="" stat_loth="25" stat_locolor="#408000" stat_hith="55" stat_hicolor="#F05000"/>
        <stat _rowcol="(2,2)" _stat_name="aof_fold" popup="default" tip="" click=""/>
        <stat _rowcol="(3,1)" _stat_name="aof_showdowns" popup="default" tip="" click=""/>
        <stat _rowcol="(3,2)" _stat_name="player_note" popup="default" tip="" click="open_comment_dialog"/>
    </ss>
    <game game_name="aof_omaha" aux="ClassicHud, mucked">
        <game_stat_set game_type="all" stat_set="aof_default"/>
    </game>
</fpdb_hud_package>
