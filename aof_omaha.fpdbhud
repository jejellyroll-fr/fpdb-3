        <stat _rowcol="(2,2)" _stat_name="aof_fold" popup="aof_profile" hudprefix="F " hudsuffix="" tip="" click=""/>
        <stat _rowcol="(2,3)" _stat_name="aof_weak" popup="aof_profile" hudprefix="wk " hudsuffix="" tip="" click=""/>
