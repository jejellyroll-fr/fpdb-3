        <stat _rowcol="(3,3)" _stat_name="aof_trips" popup="aof_profile" hudprefix="3k " hudsuffix="" tip="" click=""/>
        <stat _rowcol="(3,4)" _stat_name="aof_nfd" popup="aof_profile" hudprefix="NFD " hudsuffix="" tip="" click=""/>
        <stat _rowcol="(4,1)" _stat_name="aof_splash_won" popup="aof_profile" hudprefix="Spl " hudsuffix="" tip="" click=""/>
        <stat _rowcol="(4,2)" _stat_name="aof_splash_freq" popup="aof_profile" hudprefix="Spl% " hudsuffix="" tip="" click=""/>
    </ss>
